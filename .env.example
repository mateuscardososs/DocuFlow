# Valores ilustrativos para desenvolvimento local. Não use estes valores em produção.
POSTGRES_DB=docuflow
POSTGRES_USER=docuflow
POSTGRES_PASSWORD=docuflow_local_only
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://docuflow:docuflow_local_only@localhost:5432/docuflow
TEST_DATABASE_URL=postgresql+psycopg://docuflow:docuflow_local_only@localhost:5432/docuflow_test

# Gere uma chave local com: openssl rand -hex 32
# Configure a chave apenas no arquivo .env, que não é versionado.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
DOCUMENT_STORAGE_DIR=./var/documents
REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/15
REDIS_PORT=6379
DOCUFLOW_QUEUE_NAME=documents
DOCUFLOW_JOB_TIMEOUT_SECONDS=300
DOCUFLOW_MAX_ATTEMPTS=3
DOCUFLOW_STALE_AFTER_SECONDS=900
DOCUFLOW_OCR_LANGUAGE=por+eng
DOCUFLOW_OCR_DPI=300
DOCUFLOW_OCR_TIMEOUT_SECONDS=30
DOCUFLOW_NATIVE_TEXT_MIN_CHARS=1
DOCUFLOW_TESSERACT_CMD=tesseract
# Opcional: execute o teste com o Tesseract instalado e os idiomas configurados.
DOCUFLOW_RUN_TESSERACT_TESTS=0
