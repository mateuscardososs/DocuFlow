# Valores ilustrativos para desenvolvimento local. Não use estes valores em produção.
POSTGRES_DB=docuflow
POSTGRES_USER=docuflow
POSTGRES_PASSWORD=docuflow_local_only
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://docuflow:docuflow_local_only@localhost:5432/docuflow
TEST_DATABASE_URL=postgresql+psycopg://docuflow:docuflow_local_only@localhost:5432/docuflow_test

# Gere uma chave local com: openssl rand -hex 32
# Configure a chave apenas no arquivo .env, que não é versionado.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
