# Copie para .env.production fora do repositório e proteja com chmod 600.
# Todos os valores abaixo são ilustrativos; o validador os rejeita.
DOCUFLOW_COMPOSE_PROJECT_NAME=docuflow-production
DOCUFLOW_DOMAIN=piloto.example.invalid
DOCUFLOW_ACME_EMAIL=operador@example.invalid
DOCUFLOW_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
DOCUFLOW_HTTP_PORT=80
DOCUFLOW_HTTPS_PORT=443

POSTGRES_DB=docuflow
POSTGRES_USER=docuflow
POSTGRES_PASSWORD=REPLACE_WITH_64_URL_SAFE_CHARACTERS
REDIS_PASSWORD=REPLACE_WITH_64_URL_SAFE_CHARACTERS
JWT_SECRET_KEY=REPLACE_WITH_64_URL_SAFE_CHARACTERS

# Configure somente uma rede privada sob controle do operador.
# Para Ollama em outro container na VPS, conecte-o a essa rede sem publicar portas.
DOCUFLOW_OLLAMA_DOCKER_NETWORK=docuflow_ollama_private
DOCUFLOW_OLLAMA_BASE_URL=http://ollama:11434
DOCUFLOW_OLLAMA_MODEL=gemma4
DOCUFLOW_OLLAMA_TIMEOUT_SECONDS=60

DOCUFLOW_QUEUE_NAME=documents
DOCUFLOW_JOB_TIMEOUT_SECONDS=300
DOCUFLOW_MAX_ATTEMPTS=3
DOCUFLOW_STALE_AFTER_SECONDS=900
DOCUFLOW_ERP_QUEUE_NAME=erp-submissions
DOCUFLOW_ERP_JOB_TIMEOUT_SECONDS=60
DOCUFLOW_OCR_LANGUAGE=por+eng
DOCUFLOW_OCR_DPI=300
DOCUFLOW_OCR_TIMEOUT_SECONDS=30
DOCUFLOW_NATIVE_TEXT_MIN_CHARS=1
DOCUFLOW_TESSERACT_CMD=tesseract

# Nomes isolados dos volumes persistentes de produção.
DOCUFLOW_POSTGRES_VOLUME=docuflow_production_postgres_data
DOCUFLOW_REDIS_VOLUME=docuflow_production_redis_data
DOCUFLOW_DOCUMENTS_VOLUME=docuflow_production_private_documents
DOCUFLOW_CADDY_DATA_VOLUME=docuflow_production_caddy_data
DOCUFLOW_CADDY_CONFIG_VOLUME=docuflow_production_caddy_config
